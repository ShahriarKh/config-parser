{
  "name": "@shahriarkh/config-parser",
  "version": "0.1.4",
  "description": "A TypeScript configuration parser with Zod validation",
  "homepage": "https://github.com/shahriarkh/config-parser#readme",
  "bugs": {
    "url": "https://github.com/shahriarkh/config-parser/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahriarkh/config-parser.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "bun check",
    "build": "tsdown",
    "pack": "bun pm pack",
    "prepublishOnly": "bun run build && bun check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "verify": "bun run format:check && bun run typecheck && bun run test && bun run build",
    "prepack": "bun run build && bun run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "bun-types": "^1.4.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}
